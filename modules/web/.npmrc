# @angular/cdk and @angular/material are intentionally pinned to 14.2.7 while
# the rest of @angular/* is on 16.2.1 - bumping them breaks the Chips
# component (mat-chip-list was removed/restructured in Material 15+) and
# needs an actual component migration, not just a version bump. Until that's
# done, npm's strict peer resolution will always flag this as a conflict.
legacy-peer-deps=true
